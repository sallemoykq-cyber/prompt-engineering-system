{
  "manifest_version": 3,
  "name": "Gelişmiş Prompt Mühendisi",
  "version": "1.0",
  "description": "Yapay zeka için profesyonel prompt'lar oluşturan gelişmiş araç.",
  "permissions": ["activeTab", "sidePanel"],
  "action": {
    "default_title": "Prompt Mühendisi",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
